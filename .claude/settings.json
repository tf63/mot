{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": ["Welcome to Mot Project!!"],
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(xargs grep:*)",
      "Bash(xargs rg:*)",
      "Bash(touch:*)",
      "Bash(cp -n:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(pwd:*)",
      "Bash(wc -l:*)",
      "Bash(trash:*)",
      "Bash(sort:*)",
      "Bash(true:*)",
      "Bash(false:*)",
      "Bash(golangci-lint:*)",
      "Bash(go doc:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git branch -a)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "WebFetch(domain:zenn.dev)",
      "WebFetch(domain:qiita.com)",
      "WebFetch(domain:stackoverflow.com)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Agent(Plan)",
      "Agent(Explore)",
      "Agent(claude)",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "Agent(general-purpose)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/statusline.sh"
  },
  "plansDirectory": ".claude/plans",
  "autoMemoryDirectory": ".claude/memories",
  "enabledMcpjsonServers": [],
  "disabledMcpjsonServers": [],
  "includeCoAuthoredBy": false,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "disableWorkflows": true
}
