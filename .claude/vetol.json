{
  "mode": "allowlist",
  "rules": [
    { "command": "ls" },
    { "command": "tree" },
    { "command": "grep" },
    { "command": "rg" },
    { "command": "xargs rg" },
    { "command": "xargs grep" },
    { "command": "touch" },
    { "command": "cp", "include": ["-n"] },
    { "command": "echo" },
    { "command": "sed", "include": ["-n"] },
    { "command": "mv" },
    { "command": "mkdir" },
    { "command": "find", "exclude": ["-exec"] },
    { "command": "head" },
    { "command": "tail" },
    { "command": "pwd" },
    { "command": "wc", "include": ["-l"] },
    { "command": "trash" },
    { "command": "sort" },
    { "command": "true" },
    { "command": "false" },
    { "command": "golangci-lint" },
    { "command": "go doc" },
    { "command": "go test" },
    { "command": "go build" },
    { "command": "git add" },
    { "command": "git commit" },
    { "command": "git status" },
    { "command": "git diff" },
    { "command": "git log" },
    { "command": "git show" },
    { "command": "git branch", "include": ["-a"] },
    { "command": "git push" },
    { "command": "gh pr view" },
    { "command": "gh pr diff" },
    { "command": "gh pr list" },
    { "command": "gh pr create" },
    { "command": "gh pr review" },
    { "command": "gh api" }
  ]
}
