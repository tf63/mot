{
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": false,
  "trailingComma": "es5",
  "semi": false,
  "htmlWhitespaceSensitivity": "css",
  "sortPackageJson": false,
  "sortImport": {},
  "sortTailwindcss": {},
  "ignorePatterns": [
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/.DS_Store",
    "**/*.hbs",
    "**/node_modules/**/*",
    "**/public/**/*",
    "**/dist/**/*",
    "**/dist-ssr/**/*",
    "**/build/**/*",
    "**/storybook-static/**/*",
    "**/coverage/**/*",
    "**/bin/**/*",
    "**/obj/**/*",
    "**/out/**/*",
    "**/.yarn/**/*",
    "**/.pnpm-store/**/*",
    "**/.next/**/*",
    "**/.vercel/**/*",
    "**/.swc/**/*",
    "**/.turbo/**/*"
  ]
}
